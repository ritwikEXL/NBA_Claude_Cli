ANTHROPIC_API_KEY=your_anthropic_api_key
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TEST_SMS_NUMBER=+1xxxxxxxxxx
TEST_EMAIL=your@email.com
GMAIL_ADDRESS=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
DB_PATH=careintel.db

# ── Database — auto-detected, no manual switching needed ──────────────────────
# Leave DB_MODE unset (or sqlite) for local dev with careintel.db
# When SNOWFLAKE_ACCOUNT is present, Snowflake is used automatically.
# Set DB_MODE=sqlite explicitly to force SQLite even if Snowflake creds are set.
DB_PATH=careintel.db
# DB_MODE=sqlite   # uncomment to force SQLite

# ── Snowflake — fill these in to activate Snowflake automatically ──────────────
# Free trial (no credit card): https://signup.snowflake.com/
# SNOWFLAKE_ACCOUNT=orgname-accountname   # copy from Snowflake console
# SNOWFLAKE_USER=your_username
# SNOWFLAKE_PASSWORD=your_password
# SNOWFLAKE_DATABASE=CAREINTEL
# SNOWFLAKE_SCHEMA=NBA
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_ROLE=SYSADMIN
