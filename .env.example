ANTHROPIC_API_KEY=your_anthropic_api_key
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TEST_SMS_NUMBER=+1xxxxxxxxxx
TEST_EMAIL=your@email.com
GMAIL_ADDRESS=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
DB_PATH=careintel.db

# ── Database mode ──────────────────────────────────────────────────────────────
# DB_MODE=sqlite           # default — local SQLite (careintel.db)
# DB_MODE=snowflake        # production — Snowflake connector
DB_MODE=sqlite

# ── Snowflake (only needed when DB_MODE=snowflake) ────────────────────────────
# Free trial: https://signup.snowflake.com/
# SNOWFLAKE_ACCOUNT=your_org-your_account   # e.g. xy12345.us-east-1
# SNOWFLAKE_USER=your_snowflake_username
# SNOWFLAKE_PASSWORD=your_snowflake_password
# SNOWFLAKE_DATABASE=CAREINTEL
# SNOWFLAKE_SCHEMA=NBA
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_ROLE=SYSADMIN
